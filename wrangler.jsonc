{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "selva-tree",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "selva-tree" }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "selva-tree-hotels-resorts",
    "database_id": "6330fcfb-45bc-4b27-9c72-416467f40450",
    "migrations_dir": "migrations"
  }]
}
